# ==============================================================================
# ZEMEN MARKET (ዘመን ገበያ) — Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ZEMEN MARKET"

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://zemen_user:your_password@cluster0.mongodb.net/zemen_market?retryWrites=true&w=majority

# Authentication Secrets
# Generate using: openssl rand -base64 32
JWT_SECRET=super_secret_zemen_marketplace_jwt_key_min_32_chars_long
SESSION_COOKIE_NAME=zemen_session
COOKIE_SECURE=false # Set to true in production with HTTPS

# Marketplace Commission Defaults
# Baseline commission is 10% (0.10) on eligible product sales (excluding delivery fees)
DEFAULT_COMMISSION_RATE=0.10

# Currency Configuration
DEFAULT_CURRENCY=ETB

# Media Uploads (Cloudinary or local fallback)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Notifications (Optional Future Integration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@zemenmarket.et
SMTP_PASS=your_email_password
SMS_PROVIDER_API_KEY=
